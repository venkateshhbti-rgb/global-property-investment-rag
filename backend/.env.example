# Mode Configuration
LOCAL_MODE=True  # Set to False when you have an OpenAI API key

# OpenAI Configuration (OPTIONAL - Leave empty to run in local mode)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store Configuration
CHROMA_DB_PATH=./chroma_db
VECTOR_STORE_NAME=property_investment_db

# Data Paths (relative to backend directory)
DATA_BASE_PATH=../data

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5

# API Configuration
DEBUG=True
API_TITLE=Property Investment RAG Consultant
API_VERSION=1.0.0

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Copy this file to secrets.toml (same folder) and fill in the values.
# secrets.toml is gitignored. On Streamlit Community Cloud, paste the same lines into the app's Secrets box.

# The first admin account. Without ADMIN_PASSWORD a random password is generated and written to the app log.
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = ""

# At least one AI key. OpenAI answers and also builds the search index; Claude is optional.
OPENAI_API_KEY = ""
ANTHROPIC_API_KEY = ""

# Optional model overrides
# OPENAI_MODEL = "gpt-4o-mini"
# CLAUDE_MODEL = "claude-sonnet-5-5"
